(defcfg
  process-unmapped-keys yes
)

(defvar
  tap-time 200
  hold-time 200
)

(defsrc
  q w e r t y u i o p
  a s d f g h j k l ;
  z x c v b n m , . /
        spc
)

(deflayermap main
  a (tap-hold-release $tap-time $hold-time a lctrl)
  s (tap-hold-release $tap-time $hold-time s lshift)
  d (tap-hold-release $tap-time $hold-time d lalt)
  f (tap-hold-release $tap-time $hold-time f lmeta)
  j (tap-hold-release $tap-time $hold-time j rmeta)
  k (tap-hold-release $tap-time $hold-time k ralt)
  l (tap-hold-release $tap-time $hold-time l rshift)
  ; (tap-hold-release $tap-time $hold-time ; rctrl)
  e (tap-hold-release $tap-time $hold-time e (layer-toggle sym))
  r (tap-hold-release $tap-time $hold-time r (layer-toggle num))
  c (tap-hold-release $tap-time $hold-time c (layer-toggle fun))
  spc (tap-hold-release $tap-time $hold-time spc (layer-toggle nav))
)

(deflayer nav
  _ _ _ _ _ tab  bspc del  esc   _
  _ _ _ _ _ left down up   right ret
  _ _ _ _ _ home pgdn pgup end   _
            _
)

(deflayer sym
  S-1  `    '    S-'  S-3   S-\  S-9  S-0  S-,  S-.
  S-8  =    -    S--  S-4   ;    {    }    /    \
  S-`  S-=  ,    .    S-2   S-7  [    ]    S-;  S-/
                  _
)

(deflayer num
  _ _ _ _ _ _ 7 8 9 _
  _ _ _ _ _ 0 4 5 6 _
  _ _ _ _ _ _ 1 2 3 _
        _
)

(deflayer fun
  _ _ _ _ _ _ f7 f8 f9 f12
  _ _ _ _ _ _ f4 f5 f6 f11
  _ _ _ _ _ _ f1 f2 f3 f10
          _
)
