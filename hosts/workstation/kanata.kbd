(defcfg
  process-unmapped-keys yes
)

(defvar
  tap-time 170
  hold-time 170
)

(defsrc
  q    w    e    r    t    y    u    i    o    p
  caps a    s    d    f    g    h    j    k    l    ;
  z    x    c    v    b    n    m    ,    .    /
                 spc
)

(defalias
  caps (tap-hold-release $tap-time $hold-time esc (layer-while-held nav))
  a    (tap-hold-release $tap-time $hold-time a lctl)
  s    (tap-hold-release $tap-time $hold-time s lsft)
  d    (tap-hold-release $tap-time $hold-time d lalt)
  f    (tap-hold-release $tap-time $hold-time f lmet)
  j    (tap-hold-release $tap-time $hold-time j rmet)
  k    (tap-hold-release $tap-time $hold-time k ralt)
  l    (tap-hold-release $tap-time $hold-time l rsft)
  scln (tap-hold-release $tap-time $hold-time ; rctl)
  spc  (tap-hold-release $tap-time $hold-time spc (layer-while-held sym))
)

(deflayer base
  _    _ _ _ _ _ _ _ _ _
  @caps @a @s @d @f _ _ @j @k @l @scln
  _    _ _ _ _ _ _ _ _ _
             @spc
)

(deflayer nav
    _ _ _ _ _ _    _    _    _     _
  _ _ _ _ _ _ left down up   right _
    _ _ _ _ _ home pgdn pgup end   _
        _
)

(deflayer sym
  f1   f2 f3 f4 f5 f6   f7   f8   f9   f10
  _    _  S-1 '  S-'  S-3  S-\ S-9  S-0  S-,  S-.
  _    S-8 =  -    S-4  ;   {    }    /    \
       _
)
