(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv   1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab   q     w     e     r     t     y     u     i     o     p     [     ]     \
  caps  a     s     d     f     g     h     j     k     l     ;     '           ret
  lsft  z     x     c     v     b     n     m     ,     .     /                 rsft
  lctrl lmeta lalt              spc                                 ralt  rmeta rctrl
)

(platform (macos)
  (defalias cut M-x copy M-c pste M-v undo M-z redo M-S-z)
)
(platform (win winiov2 wintercept linux)
  (defalias cut C-x copy C-c pste C-v undo C-z redo C-S-z)
)
(deftemplate mods ()
  a lctl
  s lsft
  d lalt
  f lmet
  lctrl lctl
  lmeta lmet
  lalt lalt
  ralt ralt
  rmeta rmet
  rctrl rctl
  lsft lsft
  rsft rsft
)

(deflayermap main
  tab tab
  spc (layer-switch ins)
  q (layer-while-held fun)
  w (layer-while-held sym)
  e (layer-while-held nav)
  r (layer-while-held num)

  (t! mods)

  x @cut
  c @copy
  v @pste
  z (fork @undo @redo (lsft rsft))

  o (fork bspc del (lsft rsft))
  p esc
  h left
  j down
  k up
  l right
  ; ret

  ___ XX
)

(deflayermap nav
  (t! mods)

  h home
  j pgdn
  k pgup
  l end

  ___ XX
)

(deflayermap ins
  caps (layer-switch main)
  ___ _
)

;; Held on W. Left-hand symbols moved to the right hand, reached with Shift.
(deflayermap sym
  (t! mods)

  y (fork S-\ S-3 (lsft rsft))
  u (fork S-9 S-' (lsft rsft))
  i S-0
  o (fork S-, ` (lsft rsft))
  p (fork S-. S-1 (lsft rsft))
  h (fork ; S-4 (lsft rsft))
  j (fork { S-- (lsft rsft))
  k (fork } - (lsft rsft))
  l (fork / = (lsft rsft))
  ; (fork \ S-8 (lsft rsft))
  n (fork S-7 S-2 (lsft rsft))
  m (fork [ . (lsft rsft))
  , (fork ] , (lsft rsft))
  . (fork S-; S-= (lsft rsft))
  / (fork S-/ S-` (lsft rsft))

  ___ XX
)

(deflayermap num
  (t! mods)

  h 0
  m 1
  , 2
  . 3
  j 4
  k 5
  l 6
  u 7
  i 8
  o 9

  ___ XX
)

(deflayermap fun
  (t! mods)

  m f1
  , f2
  . f3
  j f4
  k f5
  l f6
  u f7
  i f8
  o f9
  / f10
  ; f11
  p f12

  ___ XX
)
